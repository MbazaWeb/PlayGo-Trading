MONGODB_URI="mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority"
MONGODB_DATABASE="playgo_trading"
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Local development only: public write endpoints are always disabled.
PLAYGO_ENV="local"
# Synthetic quotes are default; switch to oanda_practice for read-only OANDA practice prices.
FOREX_FEED="synthetic"
OANDA_ACCOUNT_ID=""
OANDA_API_TOKEN=""
# Optional one-process worker: run python backend/worker.py separately.
PAPER_CYCLE_SECONDS="60"
PAPER_API_URL="http://127.0.0.1:8000"
