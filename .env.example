DATABASE_URL="postgresql://postgres.<project_ref>@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"
SUPABASE_URL="https://<project_ref>.supabase.co"
SUPABASE_ANON_KEY="<supabase-anon-key>"
SUPABASE_SERVICE_ROLE_KEY="<supabase-service-role-key>"
SUPABASE_JWT="<supabase-jwt-or-session-token>"
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Local development only: public write endpoints are always disabled.
PLAYGO_ENV="local"
# Synthetic quotes are default; switch to oanda_practice for read-only OANDA practice prices.
FOREX_FEED="synthetic"
OANDA_ACCOUNT_ID=""
OANDA_API_TOKEN=""
# Optional one-process worker: run python backend/worker.py separately.
PAPER_CYCLE_SECONDS="60"
PAPER_API_URL="http://127.0.0.1:8000"

# Deriv credentials (do not commit real secrets; keep them in your local .env file)
DERIV_APP_ID=""
DERIV_API_TOKEN=""
